<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rahatsız Etme (DND) filtresini ayarlamak için: kullanıcı Ayarlar'dan onaylar -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Android 13+ bildirim gösterebilmek için çalışma zamanı izni -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Oyun Modu servisini önyüzde tutabilmek için -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Seçilen uygulamaların arka plan önbelleğini temizlemeyi denemek için (etkisi Android tarafından sınırlıdır) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Android 11+ paket görünürlüğü: yüklü/başlatılabilir uygulamaları listeleyebilmek için -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.rekoo.pubgm" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.GamePerfAssistant"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GamePerfAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/app_list_title" />

        <!--
            Oyun Modu servisi: yalnızca bildirim/DND yönetimi ve canlı durum
            bildirimi gösterir. PUBG veya başka bir uygulamanın dosyasına,
            belleğine veya sürecine hiç dokunmaz.
        -->
        <service
            android:name=".GameModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_performance_monitoring" />
        </service>

    </application>

</manifest>
