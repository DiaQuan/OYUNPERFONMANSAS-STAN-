<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/textPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <!-- OYUN MODU KARTI -->
        <com.google.android.material.card.MaterialCardView style="@style/GamePerfCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/game_mode_title"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchGameMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/game_mode_description"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textDndHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/dnd_permission_hint"
                    android:textColor="@color/accentWarning"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonOpenNotificationSettings"
                    style="@style/GamePerfTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/grant_dnd_permission" />

                <Button
                    android:id="@+id/buttonSelectApps"
                    style="@style/GamePerfOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/select_target_apps" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CİHAZ DURUMU KARTI -->
        <com.google.android.material.card.MaterialCardView style="@style/GamePerfCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_status_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRam"
                    style="@style/GamePerfStatLine"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/textBattery"
                    style="@style/GamePerfStatLine" />

                <TextView
                    android:id="@+id/textThermal"
                    style="@style/GamePerfStatLine" />

                <TextView
                    android:id="@+id/textCpu"
                    style="@style/GamePerfStatLine" />

                <Button
                    android:id="@+id/buttonRefreshStats"
                    style="@style/GamePerfOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/refresh_stats" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- YENİLEME HIZI KARTI -->
        <com.google.android.material.card.MaterialCardView style="@style/GamePerfCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh_rate_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSupportedModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textRefreshRateResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/accentPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/refresh_rate_note"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/buttonApplyRefreshRate"
                    style="@style/GamePerfOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/try_high_refresh_rate" />

                <Button
                    android:id="@+id/buttonOpenDisplaySettings"
                    style="@style/GamePerfTextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_display_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/buttonLaunchGame"
            style="@style/GamePerfPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/launch_game"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/disclaimer_text"
            android:textColor="@color/textSecondary"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
